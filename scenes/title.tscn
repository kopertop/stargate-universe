[node name="Lore" type="Label" parent="Frame/Stack"]
layout_mode = 2
text = "Icarus Base has fallen.
The ninth chevron locked. Something rushed through.

You are Eli Wallace — student, accidental savior of a dying program,
and now an uninvited passenger on the Destiny, an Ancient ship adrift
between galaxies. The lights are dim. The air, when it comes, comes wrong.

Find a way to breathe."
horizontal_alignment = 1
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.78, 0.85, 0.95, 0.9)
theme_override_constants/line_spacing = 4

