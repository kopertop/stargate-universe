; --- Doors -------------------------------------------------------------------
; Walls sit at z=±9 (south/north) and x=±7 (east/west) given floor_size 14×18.
; Door interactables are anchored AT the wall plane so the door body fills the
; wall cutout — half embedded in the wall thickness, half flush as a recessed
; panel facing the room.

[node name="GateRoomDoor" parent="." groups=["interactable"] instance=ExtResource("9_door")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.5, 0, -8.75)
target_scene = "res://scenes/gate_room.tscn"
target_spawn = "FromCorridor"
transition_prompt = "Return to the gate room"
open_prompt = "Return to the gate room"

[node name="ControlRoomDoor" parent="." groups=["interactable"] instance=ExtResource("9_door")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0.5, 0, 8.75)
target_scene = "res://scenes/control_room.tscn"
target_spawn = "FromCorridor"
transition_prompt = "Enter the control room"
open_prompt = "Enter the control room"

[node name="MessHallDoor" parent="." groups=["interactable"] instance=ExtResource("9_door")]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 6.75, 0, 0.5)
target_scene = "res://scenes/corridor_mess.tscn"
target_spawn = "FromGateRoom"
transition_prompt = "Take the mess-hall corridor"
open_prompt = "Take the mess-hall corridor"

[node name="CrewQuartersDoor" parent="." groups=["interactable"] instance=ExtResource("9_door")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -6.75, 0, 0.5)
target_scene = "res://scenes/corridor_crew.tscn"
target_spawn = "FromGateRoom"
transition_prompt = "Take the crew-quarters corridor"
open_prompt = "Take the crew-quarters corridor"

; --- Spawn markers ----------------------------------------------------------
; Each marker is set ~4 m inside its wall so the camera SpringArm has shoulder
; room behind the player and the auto-walk on arrival has a real step to cover.

[node name="FromGateRoom" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.5, 0.35, -5.0)

[node name="FromControlRoom" type="Marker3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0.5, 0.35, 5.0)

[node name="FromMessCorridor" type="Marker3D" parent="."]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 3.5, 0.35, 0.5)

[node name="FromCrewCorridor" type="Marker3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -3.5, 0.35, 0.5)

; --- Player + camera --------------------------------------------------------
; Initial spawn matches FromGateRoom so first-time arrivals from the gate room
; line up with the camera rig.
[node name="Player" parent="." node_paths=PackedStringArray("view") groups=["player"] instance=ExtResource("4_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.5, 0.35, -5.0)
view = NodePath("../View")

[node name="View" type="Node3D" parent="." node_paths=PackedStringArray("target")]
