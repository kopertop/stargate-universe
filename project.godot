; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Stargate Universe"
config/tags=PackedStringArray("sgu", "rpg", "starterkit")
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.92549, 0.92549, 0.960784, 1)
boot_splash/image="res://splash-screen.png"
config/icon="res://icon.png"

[autoload]

Audio="*res://scripts/audio.gd"
TestCapture="*res://scripts/test_capture.gd"
TrailerCapture="*res://scripts/trailer_capture.gd"
GameClock="*res://scripts/game_clock.gd"
SaveManager="*res://scripts/save_manager.gd"
GameState="*res://scripts/game_state.gd"
QuestLog="*res://scripts/quest_log.gd"
Inventory="*res://scripts/inventory.gd"
NPCState="*res://scripts/npc_state.gd"
SceneRouter="*res://scripts/scene_router.gd"
FtlLoop="*res://scripts/ftl_loop.gd"
ConsumptionManager="*res://scripts/consumption_manager.gd"
KinoRemote="*res://scripts/kino_remote.gd"
Cinematic="*res://scripts/cinematic.gd"
Settings="*res://scripts/settings.gd"
Gamepad="*res://scripts/gamepad.gd"
GamepadConfigDialog="*res://scripts/gamepad_config_dialog.gd"
PowerGrid="*res://scripts/power_grid.gd"
ShipLayout="*res://scripts/ship_layout.gd"
ProceduralShip="*res://scripts/procedural_ship.gd"
RepairRobot="*res://scripts/repair_robot.gd"
KinoMapCapture="*res://scripts/kino_map_capture.gd"
EpisodeWrap="*res://scripts/episode_wrap.gd"
EpisodeManager="*res://scripts/episode_manager.gd"

InjurySystem="*res://scripts/injury_system.gd"
MedBay="*res://scripts/med_bay.gd"
Achievements="*res://scripts/achievements.gd"
AccessibilitySettings="*res://scripts/accessibility_settings.gd"
InputRemap="*res://scripts/input_remap.gd"
AimAssist="*res://scripts/aim_assist.gd"
PuzzleHints="*res://scripts/puzzle_hint_system.gd"
AutoRetry="*res://scripts/auto_retry_system.gd"
CrewSchedule="*res://scripts/crew_schedule.gd"
CombatSystem="*res://scripts/combat_system.gd"
CommStones="*res://scripts/comm_stones.gd"
EarthVisit="*res://scripts/earth_visit.gd"
SquadCommand="*res://scripts/squad_command.gd"
RelationshipSystem="*res://scripts/relationship_system.gd"
LifeMissions="*res://scripts/life_missions.gd"
InvestigationSystem="*res://scripts/investigation_system.gd"
DiplomacySystem="*res://scripts/diplomacy_system.gd"
FactionSystem="*res://scripts/faction_system.gd"
MutinySystem="*res://scripts/mutiny_system.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/vrm/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

