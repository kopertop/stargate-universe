{
	"_comment": "FULL verbatim E1 cold-open VO (transcript §1, GateWorld). Base-clone from refs_qwen. id -> sounds/dialog/prologue/<id>.wav. Speakers/modes match docs/OPENING_SCENE_SCRIPT.md.",
	"lines": [
		{ "id": "open-scott-clearway",   "char": "scott",   "mode": "barked",   "text": "All right, get out of here. Get out of the way!" },
		{ "id": "open-scott-evac",       "char": "scott",   "mode": "panic",    "text": "This is Scott! Slow down the evac — we are comin' in too hot!" },
		{ "id": "open-wray-whereare",    "char": "wray",    "mode": "panic",    "text": "Where are we? Why didn't we come through to Earth?" },
		{ "id": "open-scott-side",       "char": "scott",   "mode": "barked",   "text": "There's no time to explain. Off to the side!" },
		{ "id": "open-scott-comein",     "char": "scott",   "mode": "standard", "text": "This is Scott — come in!" },
		{ "id": "open-marine-medic",     "char": "marine",  "mode": "panic",    "text": "I need a medic!" },
		{ "id": "open-tj-fingers",       "char": "tj",      "mode": "standard", "text": "Over here! Can you move your fingers?" },
		{ "id": "open-man-broken",       "char": "civ",     "mode": "panic",    "text": "No. I think my arm is broken." },
		{ "id": "open-tj-sling",         "char": "tj",      "mode": "standard", "text": "Okay, just hold your arm there and we'll put it in a sling, okay?" },
		{ "id": "open-scott-cleararea",  "char": "scott",   "mode": "barked",   "text": "Clear this area! There could still be more incoming!" },
		{ "id": "open-chloe-areyouok",   "char": "chloe",   "mode": "standard", "text": "Are you okay?" },
		{ "id": "open-senator-yeah",     "char": "senator", "mode": "standard", "text": "Yeah." },
		{ "id": "open-senator-whereare", "char": "senator", "mode": "standard", "text": "Where the hell are we?" },
		{ "id": "open-scott-greerwhere", "char": "scott",   "mode": "standard", "text": "Greer? Where's Colonel Young?" },
		{ "id": "open-greer-behindme",   "char": "greer",   "mode": "standard", "text": "He was right behind me." },
		{ "id": "open-greer-move",       "char": "greer",   "mode": "barked",   "text": "Move, move, move. Stay calm! Keep it down! Move, move, move, move, move." },
		{ "id": "open-scott-colonel",    "char": "scott",   "mode": "standard", "text": "Colonel? Colonel?" },
		{ "id": "open-greer-dontmove",   "char": "greer",   "mode": "barked",   "text": "Don't move!" },
		{ "id": "open-young-whereare",   "char": "young",   "mode": "whisper",  "text": "Where are we? Where are we?" },
		{ "id": "open-scott-idontknow",  "char": "scott",   "mode": "standard", "text": "I don't know, sir." },
		{ "id": "open-young-incharge",   "char": "young",   "mode": "whisper",  "text": "You're in charge, okay? You're..." },
		{ "id": "open-scott-yessir",     "char": "scott",   "mode": "standard", "text": "Yes, sir." },
		{ "id": "open-scott-tj",         "char": "scott",   "mode": "barked",   "text": "TJ!" },
		{ "id": "open-tj-coming",        "char": "tj",      "mode": "panic",    "text": "I'm coming!" },
		{ "id": "open-greer-isheok",     "char": "greer",   "mode": "standard", "text": "Is he okay?" },
		{ "id": "open-tj-dunno",         "char": "tj",      "mode": "standard", "text": "Uh, I dunno." },
		{ "id": "open-scott-wallace",    "char": "scott",   "mode": "barked",   "text": "Wallace!" },
		{ "id": "open-scott-whatisplace","char": "scott",   "mode": "standard", "text": "What is this place?" },
		{ "id": "open-eli-didwhat",      "char": "eli",     "mode": "panic",    "text": "Look, I just did what Rush told me." },
		{ "id": "open-scott-whereishe",  "char": "scott",   "mode": "standard", "text": "Where is he?" },
		{ "id": "open-eli-wentahead",    "char": "eli",     "mode": "standard", "text": "I don't know if he went ahead of me." },
		{ "id": "open-scott-rush",       "char": "scott",   "mode": "barked",   "text": "Rush!" },
		{ "id": "open-scott-findhim",    "char": "scott",   "mode": "barked",   "text": "Rush! Eli, help me find him." },
		{ "id": "open-eli-welli",        "char": "eli",     "mode": "panic",    "text": "Well, I..." },
		{ "id": "open-greer-whatwasthat","char": "greer",   "mode": "barked",   "text": "What in the hell was that?!" },
		{ "id": "open-scott-settle",     "char": "scott",   "mode": "standard", "text": "I don't know. Sergeant, I need you to get these people settled here. I need you to find out who and what we've got. Nobody leaves this room." },
		{ "id": "open-greer-yessir",     "char": "greer",   "mode": "standard", "text": "Yes, sir." },
		{ "id": "open-scott-elinow",     "char": "scott",   "mode": "barked",   "text": "Eli! Now!" }
	]
}
