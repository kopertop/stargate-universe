[node name="DestinyCorridor" type="Node3D"]
script = ExtResource("3_corridor")

; Hub-style junction: 14 wide × 18 deep, doors on all four sides. Tile centers
; run from -6.5..6.5 (x) and -8.5..8.5 (z); door index 7 along x and index 9
; along z land doorways at x=0.5 / z=0.5 — aligned with the existing decor
; centerline.
[node name="Room" type="Node3D" parent="."]
script = ExtResource("2_room")
floor_size = Vector2i(14, 18)
wall_y_scale = 5.0
ceiling_height = 5.0
floor_scene = ExtResource("6_floor")
wall_scene = ExtResource("7_wall")
wall_door_scene = ExtResource("8_walldoor")
south_door_index = 7
north_door_index = 7
east_door_index = 9
west_door_index = 9
metallic_material = SubResource("StandardMaterial3D_metallic")
ceiling_material = SubResource("StandardMaterial3D_ceiling")

[node name="World" type="Node3D" parent="Room"]

[node name="Decor" type="Node3D" parent="."]
script = ExtResource("12_decor")
corridor_width = 14.0
corridor_length = 18.0
ceiling_height = 5.0
center_x = 0.5
south_door_z = -8.5
north_door_z = 8.5
accent_color = Color(0.20, 0.75, 1.0, 1)

[node name="Environment" type="WorldEnvironment" parent="."]
environment = ExtResource("1_env")

