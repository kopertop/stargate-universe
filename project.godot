; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Stargate Universe"
config/tags=PackedStringArray("sgu", "rpg", "starterkit")
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.92549, 0.92549, 0.960784, 1)
boot_splash/image="res://splash-screen.png"
config/icon="res://icon.png"

[autoload]

Audio="*res://scripts/audio.gd"
TestCapture="*res://scripts/test_capture.gd"
TrailerCapture="*res://scripts/trailer_capture.gd"
SaveManager="*res://scripts/save_manager.gd"
GameClock="*res://scripts/game_clock.gd"
GameState="*res://scripts/game_state.gd"
QuestLog="*res://scripts/quest_log.gd"
Inventory="*res://scripts/inventory.gd"
NPCState="*res://scripts/npc_state.gd"
SceneRouter="*res://scripts/scene_router.gd"
FtlLoop="*res://scripts/ftl_loop.gd"
ConsumptionManager="*res://scripts/consumption_manager.gd"
KinoRemote="*res://scripts/kino_remote.gd"
Cinematic="*res://scripts/cinematic.gd"
PauseMenu="*res://scripts/pause_menu.gd"
CharacterPanel="*res://scripts/character_panel.gd"
CrewViewer="*res://scripts/crew_viewer.gd"
EpisodeWrap="*res://scripts/episode_wrap.gd"
Settings="*res://scripts/settings.gd"
Gamepad="*res://scripts/gamepad.gd"
GamepadConfigDialog="*res://scripts/gamepad_config_dialog.gd"
ShipLayout="*res://scripts/ship_layout.gd"
ProceduralShip="*res://scripts/procedural_ship.gd"
RepairRobot="*res://scripts/repair_robot.gd"
ShipState="*res://scripts/ship_state.gd"
KinoMapCapture="*res://scripts/kino_map_capture.gd"
MusicDirector="*res://scripts/music_director.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/vrm/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

