[gd_scene load_steps=12 format=3 uid="uid://b2qrwm5pq8tcv"]

; Quarters furniture workbench — V2.
;
; Every furniture piece is a real instanced node in the scene tree, NOT
; procedurally spawned. Click any node (Bed / Nightstand / Lamp / Locker /
; Desk / Chair) in the Scene tree, then drag in the 3D viewport with
; W (move), E (rotate), R (scale). Read the final Transform values off
; the Inspector panel and paste them back to Claude — they'll bake into
; RoomBuilder._accent_quarters in room_builder.gd.
;
; Furniture pieces are Kenney Space Station Kit (sleek sci-fi for the
; Ancient ship aesthetic) + a domestic lamp from Furniture Kit. Walls +
; floor are 10×12 m placeholder geometry matching Eli's Quarters
; (half_x = 5, half_z = 6).
;
; A tiny @tool script (quarters_preview_tint.gd) walks the furniture
; children on _ready and paints them with a brushed-steel tint so the
; props read as something other than white blobs in the editor.

[ext_resource type="Script" path="res://scripts/quarters_preview_tint.gd" id="1_tint"]
[ext_resource type="PackedScene" uid="uid://t1bghge1ttf7" path="res://models/props/space_station_kit/bed-single-cover.glb" id="2_bed"]
