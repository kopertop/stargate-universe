{
	"name": "stargate-universe",
	"private": true,
	"version": "0.0.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"start": "run-p dev dev:api",
		"dev": "bun run gen:pwa && vite",
		"dev:api": "wrangler pages dev dist --r2 GAME_ASSETS=sgu-assets --r2 GAME_DATA=sgu-game-data",
		"build": "bun run gen:pwa && tsc --noEmit && vite build",
		"gen:pwa": "bun run scripts/gen-manifest.ts && bun run scripts/gen-sw.ts",
		"mocap:to-vrma": "bun scripts/convert-bvh-to-vrma.ts",
		"preview": "vite preview --port 5173 --strictPort",
		"deploy": "bun run build && wrangler pages deploy dist",
		"typecheck": "tsc --noEmit",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify:anim": "bun run scripts/capture-anim-verify.ts",
		"test:visual": "playwright test tests/visual/",
		"test:visual:update": "playwright test tests/visual/ --update-snapshots",
		"clean": "rm -rf dist .wrangler test-results test-reports gameplay-capture scripts/screenshots scripts/reports tests/screenshots tests/results",
		"clean:all": "bun run clean && rm -rf node_modules bun.lock"
	},
	"dependencies": {
		"@ggez/anim-core": "^0.1.11",
		"@ggez/anim-exporter": "^0.1.11",
		"@ggez/anim-runtime": "^0.1.11",
		"@ggez/anim-schema": "^0.1.11",
		"@ggez/anim-three": "^0.1.11",
		"@ggez/game-dev": "^0.1.11",
		"@ggez/gameplay-runtime": "^0.1.11",
		"@ggez/render-pipeline": "^0.1.11",
		"@ggez/runtime-format": "^0.1.11",
		"@ggez/runtime-physics-crashcat": "^0.1.11",
		"@ggez/shared": "^0.1.11",
		"@ggez/three-runtime": "^0.1.11",
		"@pixiv/three-vrm": "^3.5.1",
		"@pixiv/three-vrm-animation": "^3.5.1",
		"mitt": "^3.0.1",
		"three": "^0.182.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260405.1",
		"@gltf-transform/cli": "^4.3.0",
		"@gltf-transform/core": "^4.3.0",
		"@gltf-transform/extensions": "^4.3.0",
		"@gltf-transform/functions": "^4.3.0",
		"@pixiv/types-vrmc-vrm-animation-1.0": "^3.5.3",
		"@playwright/test": "^1.59.1",
		"@types/node": "^25.6.0",
		"@types/three": "^0.182.0",
		"draco3dgltf": "^1.5.7",
		"esbuild": "^0.28.0",
		"happy-dom": "^20.9.0",
		"lil-gui": "^0.21.0",
		"meshoptimizer": "^1.1.1",
		"npm-run-all2": "^8.0.4",
		"playwright": "^1.59.1",
		"sharp": "^0.34.5",
		"typescript": "^5.9.3",
		"vite": "^7.1.12",
		"vitest": "^4.1.2",
		"wrangler": "^4.80.0"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "^4.60.1"
	},
	"overrides": {
		"@types/three": "^0.182.0",
		"three": "^0.182.0"
	}
}
