dist
node_modules
bun.lock
.env
.env*
.local

# Session state (ephemeral)
production/session-state/
production/session-logs/

# OS
.DS_Store

# E2E test artifacts
tests/screenshots/
tests/results/

package-lock.json

# Wrangler state
.wrangler/

# Claude State
.claude/worktrees/

# Tests
gameplay-capture/
test-results/
test-reports/

# Visual similarity tool output
scripts/screenshots/
scripts/reports/

# Python
__pycache__

# Codex CLI workspace (local agent state)
.codex/

# Uncompressed asset originals (kept outside asset roots so Vite doesn't ship them)
.asset-originals/
*.glb.orig
*.vrm.orig
.godot/

# Playthrough capture output (large PNGs, regenerated by tests/playthrough/).
# Excludes contents recursively but keeps the AGENTS.md cheatsheet trackable.
recordings/

# Trailer generator output (raw AVI/WAV, working files, rendered MP4s — all
# regenerated by tools/make_trailer.sh).
out/

# In-game / debug screenshot dumps (committed reference shots stay tracked,
# only the per-run output dir is ignored)
screenshots/

# HUD Karpathy-loop per-iteration captures (regenerated by tools/hud_loop.sh).
# The reference image + curated result.png at docs/hud-redesign/ stay tracked.
docs/hud-redesign/captures/
# Doc-only images don't need Godot import sidecars (the game never loads them);
# the raw blob URL serves the PNG directly.
docs/hud-redesign/*.import
docs/demo/*.import
# TTS bake-off reference audio is dev-tool input, not a game asset — Godot's
# auto-generated .import sidecars for it are noise.
tools/tts-bakeoff/**/*.import
# IndexTTS-2 baker per-run provenance reports (regenerated each bake).
tools/tts-bake/bake_report_*.json

# Local agent workspaces (per-developer skill/tooling caches — not project state)
.agents/
.cursor/

# IDEs not already covered
.idea/

# Editor swap / backup files
*.swp
*.swo
*~

# Test logs
out_*.log

# Mixamo downloads (Adobe ToS — do not redistribute). Drop under
# models/mixamo_openbot/incoming/ per docs/animation/rifle-aim-host-pipeline.md
models/mixamo_openbot/incoming/*
!models/mixamo_openbot/incoming/.gitkeep

# Mixamo character exports (Adobe ToS — build locally via tools/blender_mixamo_rifle_combat.py)
models/mixamo_openbot/Swat_*
models/mixamo_openbot/YBot_*
models/mixamo_openbot/XBot_*
models/mixamo_openbot/Eli_*
models/mixamo_openbot/Greer_*
models/mixamo_openbot/*.blend
models/mixamo_openbot/*.blend1
